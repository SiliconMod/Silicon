#the mod name as displayed in-game
displayName: "Silicon"

#the internal name of your mod
name: "silicon"

#your name
author: "Xiaobei"

#the fully qualified main class of the mod
main: "silicon.Silicon"

#the mod description as seen in the mod dialog
description: "A personal Mindustry mod adding practical blocks and features. Includes MineConverter, ItemTransferHub, DualPurposeStorager, PowerProtector, RollGenerator and more."


#the mod version
version: a0.11.0.1

#the minimum game version required to run this mod
minGameVersion: 155.4

#this is a java mod
java: true
